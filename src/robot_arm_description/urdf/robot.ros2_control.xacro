<?xml version="1.0"?>
<!-- ros2_control interfaces for the 4 arm joints (position command, position+velocity state). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="arm_joint_interfaces" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="arm_ros2_control" params="sim_backend">
    <ros2_control name="RobotArmSystem" type="system">
      <hardware>
        <xacro:if value="${sim_backend == 'gz'}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="${sim_backend == 'gz'}">
          <plugin>ign_ros2_control/IgnitionSystem</plugin>
        </xacro:unless>
      </hardware>
      <xacro:arm_joint_interfaces name="shoulder_pan_joint"/>
      <xacro:arm_joint_interfaces name="shoulder_lift_joint"/>
      <xacro:arm_joint_interfaces name="elbow_joint"/>
      <xacro:arm_joint_interfaces name="wrist_pitch_joint"/>
    </ros2_control>
  </xacro:macro>

</robot>
