<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_arm_description</name>
  <version>0.1.0</version>
  <description>URDF/Xacro description (STL meshes, ros2_control, Gazebo) of a 4-DOF servo robot arm</description>
  <maintainer email="user@example.com">arm maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <!-- Simulation packages are distro specific, install them yourself (see README):
       Humble/Fortress : ros-humble-ros-gz  +  ros-humble-ign-ros2-control
       Jazzy/Harmonic  : ros-jazzy-ros-gz   +  ros-jazzy-gz-ros2-control              -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
