<?xml version="1.0" ?>
<robot name="four_wheel" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- ============================================================ -->
<!-- base_link material                                           -->
<!-- ============================================================ -->
<gazebo reference="base_link">
  <material>Gazebo/Silver</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <gravity>true</gravity>
</gazebo>

<!-- ============================================================ -->
<!-- Camera sensor                                                -->
<!-- ============================================================ -->
<gazebo reference="camera_1">
  <sensor name="camera_sensor" type="rgbd_camera">
    <!--
      CHANGED: type="camera" -> type="rgbd_camera". The pick-and-place
      perception node (object_detector.py) needs a depth image to compute
      3D grasp positions; a plain RGB camera never gave it one. Gazebo Sim's
      rgbd_camera sensor publishes color + depth + points under this same
      <topic> base, e.g. camera/depth_camera/image, .../depth_image,
      .../points, .../camera_info.
    -->
    <pose>0 0 0 0 0 0</pose>
    <update_rate>30</update_rate>
    <visualize>true</visualize>
    <camera>
      <camera_info_topic>camera/depth_camera/camera_info</camera_info_topic>
      <horizontal_fov>1.3962634</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.05</near>
        <far>20.0</far>
      </clip>
    </camera>
    <topic>camera/depth_camera</topic>
    <gz_frame_id>camera_1_optical_frame</gz_frame_id>
  </sensor>
</gazebo>

<!-- ============================================================ -->
<!-- Ultrasonic front                                             -->
<!-- ============================================================ -->
<gazebo reference="ultra_front_1">
  <self_collide>false</self_collide>
  <sensor name="ultra_front_sensor" type="gpu_lidar">
    <pose>0 0 0 0 0 0</pose>
    <update_rate>20</update_rate>
    <visualize>false</visualize>
    <lidar>
      <scan>
        <horizontal>
          <samples>5</samples>
          <min_angle>-0.13</min_angle>
          <max_angle>0.13</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.02</min>
        <max>4.0</max>
      </range>
    </lidar>
    <topic>ultra_front/scan</topic>
    <gz_frame_id>ultra_front_1</gz_frame_id>
  </sensor>
</gazebo>

<!-- ============================================================ -->
<!-- Ultrasonic rear                                              -->
<!-- ============================================================ -->
<gazebo reference="ultra_rear_1">
  <self_collide>false</self_collide>
  <sensor name="ultra_rear_sensor" type="gpu_lidar">
    <pose>0 0 0 0 0 0</pose>
    <update_rate>20</update_rate>
    <visualize>false</visualize>
    <lidar>
      <scan>
        <horizontal>
          <samples>5</samples>
          <min_angle>-0.13</min_angle>
          <max_angle>0.13</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.02</min>
        <max>4.0</max>
      </range>
    </lidar>
    <topic>ultra_rear/scan</topic>
    <gz_frame_id>ultra_rear_1</gz_frame_id>
  </sensor>
</gazebo>

<!-- ============================================================ -->
<!-- LiDAR sensor — 360° FOV                                     -->
<!-- ============================================================ -->
<gazebo reference="lidar_1">
  <sensor name="laser" type="gpu_lidar">
    <pose>0 0 0 0 0 0</pose>
    <update_rate>10</update_rate>
    <visualize>true</visualize>
    <lidar>
      <scan>
        <horizontal>
          <samples>360</samples>
          <min_angle>-3.14159265</min_angle>
          <max_angle>3.14159265</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.12</min>
        <max>30.0</max>
      </range>
    </lidar>
    <topic>scan</topic>
    <gz_frame_id>lidar_1</gz_frame_id>
  </sensor>
</gazebo>

<!-- ============================================================ -->
<!-- IMU sensor                                                   -->
<!-- ============================================================ -->
<gazebo reference="base_link">
  <sensor name="imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <visualize>true</visualize>
    <topic>imu</topic>
    <pose>0 0 0 0 0 0</pose>
    <gz_frame_id>base_link</gz_frame_id>
  </sensor>
</gazebo>

<!-- ============================================================ -->
<!-- WHEEL FRICTION — FIX (Bug #1)                               -->
<!--                                                             -->
<!-- ORIGINAL (broken):                                          -->
<!--   fdir1 = 0 1 0  → friction1 acts laterally (Y-axis)       -->
<!--   mu1   = 1.0    → high lateral friction (wrong direction)  -->
<!--   mu2   = 0.02   → very low rolling friction               -->
<!--   Result: robot grips sideways and cannot skid-steer        -->
<!--                                                             -->
<!-- FIXED:                                                      -->
<!--   fdir1 = 1 0 0  → friction1 acts along forward (X-axis)   -->
<!--   mu1   = 10.0   → high forward grip (drives straight well) -->
<!--   mu2   = 0.1    → moderate lateral slip (skid-steer works) -->
<!--                                                             -->
<!-- For a skid-steer robot turning is achieved by differential  -->
<!-- wheel speeds that force the contact patch to SLIP laterally.-->
<!-- Low mu2 (lateral) is required; high mu1 (forward) prevents -->
<!-- undesired sliding while driving straight.                   -->
<!-- ============================================================ -->

<gazebo reference="left_front_1">
  <material>Gazebo/Black</material>
  <!-- FIX: fdir1 along X (forward), mu1=high grip, mu2=low lateral -->
  <mu1>10.0</mu1>
  <mu2>0.1</mu2>
  <fdir1>1 0 0</fdir1>
  <self_collide>false</self_collide>
  <kp>1e6</kp>
  <kd>1.0</kd>
</gazebo>

<gazebo reference="right_front_1">
  <material>Gazebo/Black</material>
  <mu1>10.0</mu1>
  <mu2>0.1</mu2>
  <fdir1>1 0 0</fdir1>
  <self_collide>false</self_collide>
  <kp>1e6</kp>
  <kd>1.0</kd>
</gazebo>

<gazebo reference="right_rear_1">
  <material>Gazebo/Black</material>
  <mu1>10.0</mu1>
  <mu2>0.1</mu2>
  <fdir1>1 0 0</fdir1>
  <self_collide>false</self_collide>
  <kp>1e6</kp>
  <kd>1.0</kd>
</gazebo>

<gazebo reference="left_rear_1">
  <material>Gazebo/Black</material>
  <mu1>10.0</mu1>
  <mu2>0.1</mu2>
  <fdir1>1 0 0</fdir1>
  <self_collide>false</self_collide>
  <kp>1e6</kp>
  <kd>1.0</kd>
</gazebo>

<!-- ============================================================ -->
<!-- Drive system — only when use_ros2_control=false             -->
<!-- ============================================================ -->
<xacro:unless value="$(arg use_ros2_control)">
  <gazebo>

    <plugin name="gz::sim::systems::DiffDrive" filename="gz-sim-diff-drive-system">
      <left_joint>left_front_wheel_joint</left_joint>
      <left_joint>left_rear_wheel_joint</left_joint>
      <right_joint>right_front_wheel_joint</right_joint>
      <right_joint>right_rear_wheel_joint</right_joint>

      <!-- FIX Bug #2: correct physical separation = 0.27 m (scaled by 1.5) -->
      <wheel_separation>0.27</wheel_separation>
      <wheel_radius>0.06</wheel_radius>

      <topic>cmd_vel</topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_topic>odom</odom_topic>
      <odom_publisher_frequency>30</odom_publisher_frequency>
      <tf_topic>/tf</tf_topic>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_front_wheel_joint</joint_name>
      <joint_name>right_front_wheel_joint</joint_name>
      <joint_name>right_rear_wheel_joint</joint_name>
      <joint_name>left_rear_wheel_joint</joint_name>
    </plugin>

  </gazebo>
</xacro:unless>

</robot>
