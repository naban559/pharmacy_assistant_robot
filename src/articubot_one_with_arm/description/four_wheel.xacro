<?xml version="1.0" ?>
<robot name="four_wheel" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:arg name="use_ros2_control" default="true"/>
<xacro:arg name="sim_mode"         default="true"/>

<xacro:include filename="$(find articubot_one)/description/materials.xacro" />
<xacro:include filename="$(find articubot_one)/description/four_wheel.gazebo" />
<xacro:include filename="$(find articubot_one)/description/arm.xacro" />
<xacro:include filename="$(find articubot_one)/description/arm_gazebo.xacro" />
<xacro:include filename="$(find articubot_one)/description/arm_ros2_control.xacro" />

<xacro:if value="$(arg use_ros2_control)">
  <xacro:include filename="$(find articubot_one)/description/four_wheel.trans" />
</xacro:if>

<!-- ============================================================ -->
<!-- Robot structure                                              -->
<!-- ============================================================ -->

<link name="base_footprint"/>

<joint name="base_footprint_to_base_link" type="fixed">
  <parent link="base_footprint"/>
  <child link="base_link"/>
  <origin xyz="0 0 0.057" rpy="0 0 0"/>
</joint>

<link name="base_link">
  <inertial>
    <origin xyz="0.0040461 0.0 0.071553" rpy="0 0 0"/>
    <mass value="5.0"/>
    <!-- Box inertia for 0.42 x 0.30 x 0.09 m chassis at 5.0 kg -->
    <inertia ixx="0.04088" iyy="0.07688" izz="0.11100" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find articubot_one)/meshes/base_link.stl" scale="0.0015 0.0015 0.0015"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0.045" rpy="0 0 0"/>
    <geometry>
      <!-- Primitive box replaces mesh collision for stability -->
      <box size="0.42 0.30 0.09"/>
    </geometry>
  </collision>
</link>

<link name="camera_1">
  <inertial>
    <origin xyz="0.0075 0.0 0.0045" rpy="0 0 0"/>
    <mass value="0.003564"/>
    <inertia ixx="2.25e-6" iyy="2.25e-6" izz="2.25e-6" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.195 0.0 -0.13875" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find articubot_one)/meshes/camera_1.stl" scale="0.0015 0.0015 0.0015"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.03 0.075 0.03"/>
    </geometry>
  </collision>
</link>

<!--
  ADDED: optical-frame child of camera_1. The RGBD sensor's actual data
  (image, depth, points) is published in standard ROS optical convention
  (x=right, y=down, z=forward/depth) by object_detector.py's
  project_pixel_to_ros_optical(). camera_1 itself has rpy="0 0 0" relative
  to base_link (i.e. physical/REP-103 convention: x-forward, z-up), so
  without this frame, anything using TF to transform a detection from
  "camera_1" straight to base_link/arm frame applies the WRONG rotation,
  treating forward-depth as if it were vertical. This child link carries
  the standard -90/0/-90 optical rotation; four_wheel.gazebo's
  <gz_frame_id> should point at THIS frame, not camera_1 directly, so
  published sensor data is correctly related to the rest of the robot.
-->
<link name="camera_1_optical_frame"/>
<joint name="camera_1_optical_joint" type="fixed">
  <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  <parent link="camera_1"/>
  <child link="camera_1_optical_frame"/>
</joint>

<link name="ultra_front_1">
  <inertial>
    <origin xyz="0.0075 0.0 0.012" rpy="0 0 0"/>
    <mass value="0.014256"/>
    <inertia ixx="4.5e-06" iyy="2.25e-6" izz="2.25e-06" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.195 0.0 -0.00375" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find articubot_one)/meshes/ultra_front_1.stl" scale="0.0015 0.0015 0.0015"/>
    </geometry>
    <material name="silver"/>
  </visual>
</link>

<link name="ultra_rear_1">
  <inertial>
    <origin xyz="-0.0075 0.0 0.012" rpy="0 0 0"/>
    <mass value="0.014256"/>
    <inertia ixx="4.5e-06" iyy="2.25e-6" izz="2.25e-06" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.195 0.0 -0.00375" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find articubot_one)/meshes/ultra_rear_1.stl" scale="0.0015 0.0015 0.0015"/>
    </geometry>
    <material name="silver"/>
  </visual>
</link>

<link name="lidar_1">
  <inertial>
    <origin xyz="0.0 0.0 0.015" rpy="0 0 0"/>
    <mass value="0.0699795"/>
    <inertia ixx="2.025e-05" iyy="2.025e-05" izz="3.375e-05" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.165 0.0 -0.12" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find articubot_one)/meshes/lidar_1.stl" scale="0.0015 0.0015 0.0015"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <cylinder radius="0.0375" length="0.06"/>
    </geometry>
  </collision>
</link>

<!-- ============================================================ -->
<!-- WHEELS - FIX: Replace mesh collision with cylinder primitive -->
<!-- Wheel radius = 0.06 m, width = 0.045 m                     -->
<!-- Cylinder axis must align with joint axis (Y-axis) → rpy π/2 -->
<!-- ============================================================ -->

<link name="left_front_1">
  <inertial>
    <origin xyz="0.0 0.0225 0.0" rpy="0 0 0"/>
    <mass value="0.21036"/>
    <inertia ixx="0.00015075" iyy="0.000252" izz="0.00015075" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.195 -0.135 -0.00375" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find articubot_one)/meshes/left_front_1.stl" scale="0.0015 0.0015 0.0015"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <!-- FIX: Cylinder primitive replaces mesh — stable ground contact -->
  <collision>
    <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    <geometry>
      <cylinder radius="0.06" length="0.045"/>
    </geometry>
  </collision>
</link>

<link name="right_front_1">
  <inertial>
    <origin xyz="0.0 -0.0225 0.0" rpy="0 0 0"/>
    <mass value="0.21036"/>
    <inertia ixx="0.00015075" iyy="0.000252" izz="0.00015075" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.195 0.135 -0.00375" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find articubot_one)/meshes/right_front_1.stl" scale="0.0015 0.0015 0.0015"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    <geometry>
      <cylinder radius="0.06" length="0.045"/>
    </geometry>
  </collision>
</link>

<link name="right_rear_1">
  <inertial>
    <origin xyz="0.0 -0.0225 0.0" rpy="0 0 0"/>
    <mass value="0.21036"/>
    <inertia ixx="0.00015075" iyy="0.000252" izz="0.00015075" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.195 0.135 -0.00375" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find articubot_one)/meshes/right_rear_1.stl" scale="0.0015 0.0015 0.0015"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    <geometry>
      <cylinder radius="0.06" length="0.045"/>
    </geometry>
  </collision>
</link>

<link name="left_rear_1">
  <inertial>
    <origin xyz="0.0 0.0225 0.0" rpy="0 0 0"/>
    <mass value="0.21036"/>
    <inertia ixx="0.00015075" iyy="0.000252" izz="0.00015075" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.195 -0.135 -0.00375" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find articubot_one)/meshes/left_rear_1.stl" scale="0.0015 0.0015 0.0015"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    <geometry>
      <cylinder radius="0.06" length="0.045"/>
    </geometry>
  </collision>
</link>

<!-- Fixed joints -->
<joint name="Rigid 1" type="fixed">
  <origin xyz="0.195 0.0 0.13875" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="camera_1"/>
</joint>

<joint name="Rigid 2" type="fixed">
  <origin xyz="0.195 0.0 0.00375" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="ultra_front_1"/>
</joint>

<joint name="Rigid 3" type="fixed">
  <origin xyz="-0.195 0.0 0.00375" rpy="0 0 3.14159"/>
  <parent link="base_link"/>
  <child link="ultra_rear_1"/>
</joint>

<joint name="Rigid 4" type="fixed">
  <origin xyz="0.165 0.0 0.12" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="lidar_1"/>
</joint>

<!-- Wheel joints — axis stays Y (0 1 0) for correct skid-steer -->
<joint name="left_front_wheel_joint" type="continuous">
  <origin xyz="0.195 0.135 0.00375" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="left_front_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="right_front_wheel_joint" type="continuous">
  <origin xyz="0.195 -0.135 0.00375" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="right_front_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="right_rear_wheel_joint" type="continuous">
  <origin xyz="-0.195 -0.135 0.00375" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="right_rear_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="left_rear_wheel_joint" type="continuous">
  <origin xyz="-0.195 0.135 0.00375" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="left_rear_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<!-- ============================================================ -->
<!-- Arm + gripper, mounted centered on top of the chassis        -->
<!-- ============================================================ -->
<xacro:k12_arm parent="base_link" mount_x="0.12" mount_y="0.0" mount_z="0.142"/>
<xacro:k12_arm_gazebo/>

</robot>
