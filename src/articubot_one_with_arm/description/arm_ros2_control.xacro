<?xml version="1.0"?>
<robot name="k12_arm_ros2_control" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="use_arm_ros2_control" default="true"/>

  <!--
    position_proportional_gain / position_derivative_gain: gz_ros2_control's
    GazeboSimSystem drives "position" command interfaces with an internal
    PD loop, not a true kinematic position lock. If left unset it defaults
    to position_proportional_gain = 0.1, which is far too weak to hold any
    real arm link against gravity, which is why the arm was collapsing
    (see ISSUE 3 in the accompanying explanation). Values below are sized
    roughly to each joint's effort limit in arm.xacro (bigger joint closer
    to the base = bigger gain needed to counter the longer gravity lever
    arm of everything it's carrying).
  -->
  <xacro:if value="$(arg use_arm_ros2_control)">
    <ros2_control name="K12ArmSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <joint name="arm_base_yaw_joint">
        <command_interface name="position">
          <param name="position_proportional_gain">214.2</param>
          <param name="position_derivative_gain">8.57</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="arm_shoulder_pitch_joint">
        <command_interface name="position">
          <param name="position_proportional_gain">428.4</param>
          <param name="position_derivative_gain">17.14</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">-1.35</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="arm_elbow_pitch_joint">
        <command_interface name="position">
          <param name="position_proportional_gain">321.3</param>
          <param name="position_derivative_gain">12.85</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">2.20</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="arm_wrist_pitch_joint">
        <command_interface name="position">
          <param name="position_proportional_gain">171.4</param>
          <param name="position_derivative_gain">6.43</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">-0.85</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="arm_wrist_roll_joint">
        <command_interface name="position">
          <param name="position_proportional_gain">64.3</param>
          <param name="position_derivative_gain">2.15</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="left_gripper_joint">
        <command_interface name="position">
          <param name="position_proportional_gain">500.0</param>
          <param name="position_derivative_gain">10.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="right_gripper_joint">
        <command_interface name="position">
          <param name="position_proportional_gain">500.0</param>
          <param name="position_derivative_gain">10.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:if>
  <!--
    NOTE: no separate <gazebo><plugin>gz_ros2_control...</plugin></gazebo>
    block here on purpose. Ignition only starts one controller_manager per
    model, so this ros2_control block is loaded by the SAME
    gz_ros2_control::GazeboSimROS2ControlPlugin declared once in
    four_wheel.trans (which already points at my_controllers.yaml, now
    extended with arm_position_controller / gripper_position_controller).
    Adding a second plugin block here would start a second competing
    controller_manager and neither would spawn controllers reliably.

    IMPORTANT: this <ros2_control> block's hardware name is "K12ArmSystem"
    and its joints are arm_base_yaw_joint / arm_shoulder_pitch_joint /
    arm_elbow_pitch_joint / arm_wrist_pitch_joint / arm_wrist_roll_joint /
    left_gripper_joint / right_gripper_joint. If your simulation log shows
    a DIFFERENT hardware name (e.g. "RobotArmSystem") or different joint
    names (e.g. "shoulder_joint", "elbow_joint", "base_to_link1"), that
    means some OTHER file in your build, not this one, is the one
    actually being loaded. Search your workspace for those strings and
    remove/rename whatever else defines a <ros2_control> block, then do a
    clean rebuild (rm -rf build install log && colcon build).
  -->
</robot>
