<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="k12_test_cube">
    <static>false</static>
    <link name="link">
      <inertial>
        <mass>0.18</mass>
        <inertia>
          <ixx>0.000075</ixx>
          <iyy>0.000075</iyy>
          <izz>0.000075</izz>
