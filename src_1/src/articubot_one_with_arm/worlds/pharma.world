    <!-- Blue Block -->
    <model name="k12_blue_block">
      <static>false</static>
      <pose>1.44 -0.08 0.1422 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.6075</mass>
          <inertia>
            <ixx>0.000558</ixx>
            <iyy>0.000558</iyy>
            <izz>0.000558</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.07425 0.07425 0.07425</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>3.0</mu>
                <mu2>3.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>5000</kp>
                <kd>20</kd>
                <max_vel>0.1</max_vel>
                <min_depth>0.0005</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.07425 0.07425 0.07425</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.95 1</ambient>
            <diffuse>0.05 0.05 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>