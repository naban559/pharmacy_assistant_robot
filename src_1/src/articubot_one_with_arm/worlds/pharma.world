<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="pharmacy_world">
    
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>5000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name='pharmacy_arena'>
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <!-- OUTER WALLS -->

      <link name='Wall_Top'>
        <pose>0 3.75 0.75 0 0 0</pose>
        <visual name='v'>
          <geometry><box><size>12.5 0.125 1.5</size></box></geometry>
        </visual>
        <collision name='c'>
          <geometry><box><size>12.5 0.125 1.5</size></box></geometry>
        </collision>
      </link>

      <link name='Wall_Bottom'>
        <pose>0 -3.75 0.75 0 0 0</pose>
        <visual name='v'>
          <geometry><box><size>12.5 0.125 1.5</size></box></geometry>
        </visual>
        <collision name='c'>
          <geometry><box><size>12.5 0.125 1.5</size></box></geometry>
        </collision>
      </link>

      <link name='Wall_Left'>
        <pose>-6.25 0 0.75 0 0 0</pose>
        <visual name='v'>
          <geometry><box><size>0.125 7.5 1.5</size></box></geometry>
        </visual>
        <collision name='c'>
          <geometry><box><size>0.125 7.5 1.5</size></box></geometry>
        </collision>
      </link>

      <link name='Wall_Right'>
        <pose>6.25 0 0.75 0 0 0</pose>
        <visual name='v'>
          <geometry><box><size>0.125 7.5 1.5</size></box></geometry>
        </visual>
        <collision name='c'>
          <geometry><box><size>0.125 7.5 1.5</size></box></geometry>
        </collision>
      </link>

      <!-- TOP CENTER WALL -->
      <link name='Top_Center'>
        <pose>0 2.5 0.75 0 0 0</pose>
        <visual name='v'>
          <geometry><box><size>0.125 2.5 1.5</size></box></geometry>
        </visual>
        <collision name='c'>
          <geometry><box><size>0.125 2.5 1.5</size></box></geometry>
        </collision>
      </link>

      <!-- BOTTOM CENTER WALL -->
      <link name='Bottom_Center'>
        <pose>0 -2.5 0.75 0 0 0</pose>
        <visual name='v'>
          <geometry><box><size>0.125 2.5 1.5</size></box></geometry>
        </visual>
        <collision name='c'>
          <geometry><box><size>0.125 2.5 1.5</size></box></geometry>
        </collision>
      </link>

      <!-- LEFT CENTER WALL -->
      <link name='Left_Center'>
        <pose>-5 0 0.75 0 0 0</pose>
        <visual name='v'>
          <geometry><box><size>2.5 0.125 1.5</size></box></geometry>
        </visual>
        <collision name='c'>
          <geometry><box><size>2.5 0.125 1.5</size></box></geometry>
        </collision>
      </link>

      <!-- RIGHT CENTER WALL -->
      <link name='Right_Center'>
        <pose>5 0 0.75 0 0 0</pose>
        <visual name='v'>
          <geometry><box><size>2.5 0.125 1.5</size></box></geometry>
        </visual>
        <collision name='c'>
          <geometry><box><size>2.5 0.125 1.5</size></box></geometry>
        </collision>
      </link>

      <!-- SHELF A -->
      <link name='Shelf_A'>
        <pose>-5 2.5 0.10 0 0 0</pose>
        <visual name='v'>
          <geometry><box><size>0.75 0.75 0.25</size></box></geometry>
        </visual>
        <collision name='c'>
          <geometry><box><size>0.75 0.75 0.25</size></box></geometry>
        </collision>
      </link>

      <!-- SHELF B -->
      <link name='Shelf_B'>
        <pose>5 2.5 0.10 0 0 0</pose>
        <visual name='v'>
          <geometry><box><size>0.75 0.75 0.25</size></box></geometry>
        </visual>
        <collision name='c'>
          <geometry><box><size>0.75 0.75 0.25</size></box></geometry>
        </collision>
      </link>

      <!-- SHELF C -->
      <link name='Shelf_C'>
        <pose>-5 -2.5 0.10 0 0 0</pose>
        <visual name='v'>
          <geometry><box><size>0.75 0.75 0.25</size></box></geometry>
        </visual>
        <collision name='c'>
          <geometry><box><size>0.75 0.75 0.25</size></box></geometry>
        </collision>
      </link>

      <!-- SHELF D -->
      <link name='Shelf_D'>
        <pose>5 -2.5 0.10 0 0 0</pose>
        <visual name='v'>
          <geometry><box><size>0.75 0.75 0.25</size></box></geometry>
        </visual>
        <collision name='c'>
          <geometry><box><size>0.75 0.75 0.25</size></box></geometry>
        </collision>
      </link>

    </model>

    <!-- Table 1 (Pickup) -->
    <model name="k12_object_table">
      <static>true</static>
      <pose>1.5 0.0 0.0 0 0 0</pose>
      <link name="table_link">
        <collision name="top_collision">
          <pose>0 0 0.09 0 0 0</pose>
          <geometry>
            <box>
              <size>0.30 0.25 0.02</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>2.5</mu>
                <mu2>2.5</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.09 0 0 0</pose>
          <geometry>
            <box>
              <size>0.30 0.25 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.52 1</ambient>
            <diffuse>0.55 0.55 0.52 1</diffuse>
          </material>
        </visual>
        <collision name="leg_collision">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry>
            <box>
              <size>0.10 0.10 0.08</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg_visual">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry>
            <box>
              <size>0.10 0.10 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.38 0.38 0.38 1</ambient>
            <diffuse>0.38 0.38 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table 2 (Place) -->
    <model name="k12_place_table">
      <static>true</static>
      <pose>3.5 0.0 0.0 0 0 0</pose>
      <link name="table_link">
        <collision name="top_collision">
          <pose>0 0 0.09 0 0 0</pose>
          <geometry>
            <box>
              <size>0.30 0.25 0.02</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>2.5</mu>
                <mu2>2.5</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.09 0 0 0</pose>
          <geometry>
            <box>
              <size>0.30 0.25 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.52 1</ambient>
            <diffuse>0.55 0.55 0.52 1</diffuse>
          </material>
        </visual>
        <collision name="leg_collision">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry>
            <box>
              <size>0.10 0.10 0.08</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg_visual">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry>
            <box>
              <size>0.10 0.10 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.38 0.38 0.38 1</ambient>
            <diffuse>0.38 0.38 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

